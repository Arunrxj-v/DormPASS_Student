# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (compose `db` binds 127.0.0.1:5433).
DATABASE_URL=postgresql+psycopg://hostelpass:hostelpass@127.0.0.1:5433/hostelpass

# Secret for JWT HS256 signing. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Fernet key for encrypting face templates at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_TEMPLATE_KEY=

# Comma-separated list of allowed browser origins (dev).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# In-memory sliding-window rate limits (single-process, documented).
RATE_LIMIT_VERIFY_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Optional institution-level curfew window shown on the app's sign-in screen
# (display only; each hostel's DB window is authoritative for verification).
# Format 24h "HH:MM". Leave unset for the app's "set by your hostel" fallback.
CURFEW_WINDOW_START=20:30
CURFEW_WINDOW_END=22:30
CURFEW_TIMEZONE=Asia/Kolkata

# --- Account provisioning ---------------------------------------------------
# Lifetime of a warden-issued password-setup link (seconds). Default 7 days.
ACTIVATION_TOKEN_TTL_SECONDS=604800

# Warden hand-off: POST /warden/students/{id}/activate (and resend) returns the
# freshly issued plaintext activation key in the response so the warden can copy
# it and send it to the student through WhatsApp. The key is returned ONLY at
# that issuance moment, ONLY to the authorized issuer — never from read
# endpoints, never in logs (only its SHA-256 hash is stored). Set false to
# withhold it and rely on the activation email alone.
ALLOW_INLINE_ACTIVATION_TOKEN=true

# --- Email delivery (activation links) --------------------------------------
# Explicit mode; behavior is never inferred from which variables happen to be
# set. off  = never send; the API reports email_status="not_configured".
#          log  = development: the rendered .eml (with the activation link)
#                 is written to EMAIL_LOG_DIR for local inspection; the token
#                 is never written to application logs.
#          smtp = production/home server: delivered via SMTP (STARTTLS;
#                 implicit TLS on port 465).
EMAIL_MODE=off
# SMTP provider (required when EMAIL_MODE=smtp). Credentials come from the
# environment ONLY — never commit real values.
#
# Resend (recommended for DormPASS transactional mail):
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
#   ^ Resend's SMTP username is literally "resend".
# SMTP_PASSWORD: put your Resend API key here — OR keep it in this same
# untracked file as RESEND_API_KEY=... and compose will fall back to it
# automatically (SMTP_PASSWORD: ${SMTP_PASSWORD:-${RESEND_API_KEY:-}}).
# Never write the key into any git-tracked file.
SMTP_PASSWORD=
# Envelope sender ("DormPASS <noreply@your-domain>"). The domain MUST be
# verified in Resend before production sending — unverified domains are
# rejected at send time and the API will honestly report email_status=failed.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DormPASS
# Name mapping if you are following Resend's docs (SMTP_USER / SMTP_PASS /
# SMTP_SECURE / SMTP_FROM): SMTP_USER=SMTP_USERNAME, SMTP_PASS=SMTP_PASSWORD
# (or RESEND_API_KEY), SMTP_FROM=SMTP_FROM_EMAIL, and SMTP_SECURE=true is
# implicit — this backend uses TLS-from-connect whenever SMTP_PORT=465.
# STARTTLS still applies on non-465 ports (587). Set SMTP_USE_TLS=false only
# for a trusted local development relay that does not offer STARTTLS.
SMTP_USE_TLS=true
# Public base URL of this deployment (no trailing slash). Used to build the
# activation link that goes INTO emails — students must never receive a
# localhost URL. Production example: https://hostelpass.example.edu
APP_BASE_URL=http://localhost:8000
# Dev-only outbox directory for EMAIL_MODE=log (relative to the server dir).
EMAIL_LOG_DIR=var/outbox

# --- Google Sign-In (optional) ----------------------------------------------
# OAuth Web client id used as the audience when verifying Google ID tokens.
# Empty => POST /auth/google returns 503 google_signin_not_configured.
# Google sign-in authenticates EXISTING accounts only (no create, no link).
GOOGLE_OAUTH_CLIENT_ID=
