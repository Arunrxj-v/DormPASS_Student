<?xml version="1.0" encoding="utf-8"?>
<!--
  Transport policy for HostelPass.

  Android 9+ (API 28) refuses cleartext (plain http://) traffic by default.
  This app talks to a self-hosted server that, in development, is reached at
  http://10.0.2.2:8000 (the emulator's alias for the host machine) or over a
  Tailscale address — so those specific hosts must be allowed explicitly.

  Everything else keeps the platform default: cleartext DENIED. Setting
  android:usesCleartextTraffic="true" globally would also allow a mis-set
  API_BASE_URL to silently downgrade a real deployment to plain HTTP, so it is
  deliberately not used.

  Adding a development host: append one <domain> line below with the exact
  hostname or IP passed via the API_BASE_URL dart-define. There is no CIDR or
  wildcard support — that is the point. For anything beyond a trusted network,
  terminate TLS at a reverse proxy (see docs/DEPLOYMENT.md) and use https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Android emulator -> host machine loopback alias. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
